{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://innia.local/schema/fuente.json",
  "title": "Fuente",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "titulo", "organizacion", "tipo", "url", "consultado"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Identificador único en kebab-case."
    },
    "titulo": { "type": "string", "minLength": 3 },
    "organizacion": { "type": "string", "minLength": 2 },
    "tipo": {
      "type": "string",
      "enum": ["guia-oficial", "organizacion", "articulo-academico", "ministerio", "libro"]
    },
    "url": { "type": "string", "format": "uri" },
    "idiomaOriginal": { "type": "string", "enum": ["es", "en"] },
    "consultado": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nota": { "type": "string" }
  }
}
